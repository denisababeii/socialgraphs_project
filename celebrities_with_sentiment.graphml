      <data key="d13">Charles_the_Bald</data>
      <data key="d14">{{short description|King of West Francia from 843 to 877 and Carolingian Emperor from 875 to 877}}
{{Distinguish|Charles the Bold|Charles IV of France}}
{{Use dmy dates|date=June 2023}}
