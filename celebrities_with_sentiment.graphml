|notable_works    = {{ubl|''[[The 120 Days of Sodom]]'' (1785)|''[[Justine (de Sade novel)|Justine]]'' (1791)|''[[Philosophy in the Bedroom]]'' (1795)|''[[Juliette (novel)|Juliette]]'' (1799)}}
